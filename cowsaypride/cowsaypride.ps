%!PS

/COWTOP (^__^) def
/COWMID (\(oo\)) def
/COWBOT (\(__\)) def
/COWFONT /Courier-Bold def
/COWFONTSIZE 162 def
/PAGEWIDTH 900 def
/PAGEHEIGHT 540 def
/XFUDGE 1.0 def
/YFUDGE 1.44 def

<< /PageSize [ PAGEWIDTH PAGEHEIGHT ] >> setpagedevice

/stripe { % fraction ordinal r g b --
    gsave
    setrgbcolor
    /ordinal exch def
    /fraction exch def
    PAGEHEIGHT fraction div /stripeheight exch def
    newpath
    0 stripeheight ordinal mul moveto
    PAGEWIDTH 0 rlineto
    0 stripeheight rlineto
    -1 PAGEWIDTH mul 0 rlineto
    % 0 -1 stripeheight mul rmoveto
    closepath
    fill
    grestore
} def

/graystripe { %- fraction ordinal shade --
    dup dup stripe
} def

/cowpath { % x y --
    newpath
    /lly exch def
    /llx exch def
    % lly = (lly\n) print
    % llx = (llx\n) print
    llx lly COWFONTSIZE 2 mul add moveto
    COWTOP true charpath
    llx lly COWFONTSIZE add moveto
    COWMID true charpath
    llx lly moveto
    COWBOT true charpath
    closepath
} def

/fromhexcolor { 256 div } def

% #800080
/VIOLET { 0.5 0.0 0.5 } def
% #0000ff
/BLUE { 0.0 0.0 1.0 } def
% #00ff00
/GREEN { 0.0 1.0 0.0 } def
% #ffff00
/YELLOW { 1.0 1.0 0.0 } def
% #ff8000
/ORANGE { 1.0 0.5 0.0 } def
% #ff0000
/RED { 1.0 0.0 0.0 } def
% #ffffff
/WHITE { 1 1 1 } def
% #000000
/BLACK { 0 0 0 } def

% https://en.wikipedia.org/wiki/Bisexual_flag
% #0038a8
/ROYALBLUE { 0 56 fromhexcolor 168 fromhexcolor } def
% #9b4f96
/LAVENDER { 155 fromhexcolor 79 fromhexcolor 150 fromhexcolor } def
% #d60270
/MAGENTA { 214 fromhexcolor 2 fromhexcolor 112 fromhexcolor } def

