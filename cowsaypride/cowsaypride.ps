%!PS

/COWTOP (^__^) def
/COWMID (\(oo\)) def
/COWBOT (\(__\)) def
/BULLTOP (\\_^__^_/) def
/BULLMID (  \(oo\)  ) def
/BULLBOT (  \(__\)  ) def
/COWFONT /Courier-Bold def
/COWFONTSIZE 162 def
/PAGEWIDTH 900 def
/PAGEHEIGHT 540 def
/XFUDGE 1.0 def
/YFUDGE 1.44 def

<< /PageSize [ PAGEWIDTH PAGEHEIGHT ] >> setpagedevice

/stripe { % fraction ordinal r g b --
    gsave
    setrgbcolor
    /ordinal exch def
    /fraction exch def
    PAGEHEIGHT fraction div /stripeheight exch def
    newpath
    0 stripeheight ordinal mul moveto
    PAGEWIDTH 0 rlineto
    0 stripeheight rlineto
    -1 PAGEWIDTH mul 0 rlineto
    % 0 -1 stripeheight mul rmoveto
    closepath
    fill
    grestore
} def

/graystripe { %- fraction ordinal shade --
    dup dup stripe
} def

/cowpath { % x y --
    newpath
    /lly exch def
    /llx exch def
    llx lly COWFONTSIZE 2 mul add moveto
    COWTOP true charpath
    llx lly COWFONTSIZE add moveto
    COWMID true charpath
    llx lly moveto
    COWBOT true charpath
    closepath
} def

/bullpath { % x y --
    newpath
    /lly exch def
    /llx exch def
    llx lly COWFONTSIZE 2 mul add moveto
    BULLTOP true charpath
    llx lly COWFONTSIZE add moveto
    BULLMID true charpath
    llx lly moveto
    BULLBOT true charpath
    closepath
} def

/cowtrace {
    COWFONT findfont COWFONTSIZE scalefont setfont
    0 0 cowpath pathbbox
    pstack
    exch 3 1 roll
    exch sub
    /cowpathheight exch def
    exch sub
    /cowpathwidth exch def
} def

/bulltrace {
    COWFONT findfont COWFONTSIZE scalefont setfont
    0 0 bullpath pathbbox
    pstack
    exch 3 1 roll
    exch sub
    /bullpathheight exch def
    exch sub
    /bullpathwidth exch def
} def

/cowplace { % x y --
    cowpath clip
} def

/bullplace { % x y --
    bullpath clip
} def

/typicalcowplace {
    PAGEWIDTH cowpathwidth sub 2 div XFUDGE mul
    PAGEHEIGHT cowpathheight sub 2 div YFUDGE mul
    cowplace
} def

/typicalbullplace {
    PAGEWIDTH bullpathwidth sub 2 div XFUDGE mul
    PAGEHEIGHT bullpathheight sub 2 div YFUDGE mul
    bullplace    
} def

/fromhexcolor { 256 div } def

