%!PS
% gs -dNOSAFER

(cowsaypride.ps) run

% % https://en.wikipedia.org/wiki/Bisexual_flag

5 0 ROYALBLUE stripe
5 1 ROYALBLUE stripe
5 2 BILAVENDER stripe
5 3 MAGENTA stripe
5 4 MAGENTA stripe

% invert color sequence within cow head
COWFONT findfont COWFONTSIZE scalefont setfont
% cowrender
0 0 cowpath pathbbox
pstack
exch 3 1 roll
exch sub
% dup = (cowpathheight\n) print
/cowpathheight exch def
exch sub
% dup = (cowpathwidth\n) print
/cowpathwidth exch def
PAGEWIDTH cowpathwidth sub 2 div XFUDGE mul
% dup = (clipx\n) print
PAGEHEIGHT cowpathheight sub 2 div YFUDGE mul
% dup = (clipy\n) print
cowpath clip

1 0 0.63 graystripe

showpage
