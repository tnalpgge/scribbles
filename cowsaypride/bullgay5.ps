%!PS
% gs -dNOSAFER

% https://en.wikipedia.org/wiki/Gay_men's_flags
% five-stripe variant

(cowsaypride.ps) run

5 0 GAYMENDARKBLUE stripe
5 1 GAYMENLIGHTBLUE stripe
5 2 WHITE stripe
5 3 GAYMENLIGHTGREEN stripe
5 4 GAYMENDARKGREEN stripe

% invert color sequence within cow head
COWFONT findfont COWFONTSIZE scalefont setfont
% cowrender
0 0 cowpath pathbbox
pstack
exch 3 1 roll
exch sub
% dup = (cowpathheight\n) print
/cowpathheight exch def
exch sub
% dup = (cowpathwidth\n) print
/cowpathwidth exch def
PAGEWIDTH cowpathwidth sub 2 div XFUDGE mul
% dup = (clipx\n) print
PAGEHEIGHT cowpathheight sub 2 div YFUDGE mul
% dup = (clipy\n) print
cowpath clip

5 0 GAYMENDARKGREEN stripe
5 1 GAYMENLIGHTGREEN stripe
5 2 BLACK stripe
5 3 GAYMENLIGHTBLUE stripe
5 4 GAYMENDARKBLUE stripe

showpage
