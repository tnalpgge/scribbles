%!PS
% gs -dNOSAFER -dNOPAUSE -dBATCH -sDEVICE=pngalpha -sOutputFile=cowgayanimated%02d.png cowgayanimated.ps
% convert -delay 1 -colors 256 -dispose previous -loop 0 cowgayanimated*.png cowgayanimated.gif

% https://en.wikipedia.org/wiki/Rainbow_flag_(LGBTQ)
% six-stripe 1979 variant

(cowsaypride.ps) run

/PAGEWIDTH 540 def
<< /PageSize [ PAGEWIDTH PAGEHEIGHT ] >> setpagedevice

/colorprocs [
    { PRIDEVIOLET }
    { PRIDEBLUE }
    { PRIDEGREEN }
    { PRIDEYELLOW }
    { PRIDEORANGE }
    { PRIDERED }
] def

/cplen { colorprocs length } def

% aryprocs is array of procs that push 3 reals within [0,1] on stack
% (i.e. a permutation of colorprocs) for eventual use with setrgbcolor
/indexedstripe { % aryprocs n --
    /i exch def
    /a exch def
    a length
    i
    a i get exec
    stripe
} def

/cowgaypage { % n -- 
    /j exch def
    0 1 cplen 1 sub {
	[ colorprocs aload pop cplen j roll ]
	exch
	indexedstripe
    } for
    cowtrace
    typicalcowplace
    1 0 WHITE stripe
    showpage    
} def

0 1 cplen 1 sub { cowgaypage } for
